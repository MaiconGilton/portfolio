---
import "../styles/global.css";
import "../styles/toggle-theme.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#21252A" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <meta name="description" content="Maicon's personal portfolio website" />
    <meta name="author" content="Maicon Freire" />
    <meta
      name="keywords"
      content="Maicon Freire, Maicon Gilton, Maicon Freire portfolio"
    />

    <meta property="og:title" content="Maicon – Portfolio" />
    <meta
      property="og:description"
      content="Senior Full-Stack Developer who loves building web, mobile, and back-end applications using React, Next.js, React Native, SwiftUI, Golang, Node.js and TypeScript."
    />
    <meta
      property="og:image"
      content="https://maiconfreire.site/images/profile.webp"
    />
    <meta property="og:url" content="https://maiconfreire.site" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Maicon – Portfolio" />
    <meta property="og:locale" content="en_US" />

    <title>Maicon - Portfolio</title>

    <link rel="icon" type="image/png" href="images/ico.png" />

    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet';this.removeAttribute('as')"
      as="style"
    />
  </head>

  <body>
    <div id="preloader">
      <div class="jumper">
        <div></div>
        <div></div>
        <div></div>
      </div>
    </div>

    <slot />

    <script type="text/javascript" src="/scrollreveal.min.js"></script>
    <script src="../scripts/local.js"></script>
  </body>
</html>

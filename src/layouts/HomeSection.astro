---
import SocialIcons from "../components/SocialIcons.astro";
---

<section
  id="home"
  class="h-screen pt-10 md:pt-16 flex flex-col-reverse md:flex-row items-center gap-10 justify-center md:justify-between"
  id="about"
>
  <div class="flex flex-col md:w-1/2">
    <h1
      class="text-2xl md:text-[50px] text-black dark:text-white font-bold text-center md:text-left"
      data-scroll-reveal="enter left move 30px over 0.4s after 0.4s"
    >
      <span class="text-lg">Hi! I’m Maicon,</span><br />
      Full-Stack Developer
    </h1>

    <div
      class="w-full bg-gray-400 h-[1px] my-5 md:my-10"
      data-scroll-reveal="enter right over 0.4s after 0.4s"
    >
    </div>

    <p
      class="text-center md:text-left"
      data-scroll-reveal="enter bottom move 30px over 0.4s after 0.4s"
    >
      Senior full-stack developer who loves building web, mobile, and back-end
      applications using React, Next.js, React Native, SwiftUI, Golang, Node.js
      and TypeScript.
    </p>

    <a
      id="home__cta"
      class="button--primary my-6 md:my-8 self-center md:self-start"
      href="#about"
      data-scroll-reveal="enter bottom move 30px over 0.4s after 0.4s"
      >Learn more</a
    >

    <div
      class="social-buttons justify-center md:justify-start"
      data-scroll-reveal="enter bottom move 30px over 0.4s after 0.4s"
    >
      <SocialIcons />
    </div>
  </div>

  <div
    class="md:w-1/2 rounded-[200px] aspect-square h-auto max-w-[200px] md:max-w-[400px] overflow-hidden bg-[gray] border border-gray-400"
    data-scroll-reveal="enter top move 30px over 0.4s after 0.4s"
  >
    <img
      class="max-h-[300px] md:max-h-[500px] m-auto"
      src="./images/profile.webp"
      alt="User image"
      loading="lazy"
    />
  </div>
</section>

<section id="projects">
  <h2 class="section__title">Projects</h2>

  <p class="section__subtitle">
    A showcase of my work, demonstrating my expertise in building innovative,
    scalable, and user-centered applications across a variety of technologies
    and industries.
  </p>

  <div class="project__container">
    {
      projects.map((project, index) => (
        <div
          class="project__item"
          data-scroll-reveal={`enter bottom move 30px over 0.4s after 0.${2 + index}s`}
        >
          <h3 class="project__title">{project.title}</h3>

          <p class="project__description">{project.description}</p>

          <img
            src={"./images/project/" + project.image}
            alt="project"
            class="project__img"
            loading="lazy"
          />

          <button
            data-project-id={project.id}
            class="project__button button--primary"
          >
            See more
          </button>
        </div>
      ))
    }
  </div>
</section>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  // Show project details modal
  document.addEventListener("click", async (e) => {
    if (e.target.matches("[data-project-id]")) {
      const projectId = e.target.dataset.projectId;
      const projectUrl = "/project/" + projectId;

      if (!projectUrl) return;

      const response = await fetch(projectUrl);
      const htmlContent = await response.text();
      window.showModal(htmlContent);
    }
  });

  let lightbox: any;
  const observer = new MutationObserver((mutations) => {
    // biome-ignore lint/complexity/noForEach: <explanation>
    mutations.forEach((mutation) => {
      if (mutation.type === "childList") {
        const gallery = document.querySelector("#project__gallery");

        if (gallery) {
          if (lightbox) {
            lightbox.destroy();
          }

          lightbox = new PhotoSwipeLightbox({
            gallery: "#project__gallery",
            children: "a",
            pswpModule: () => import("photoswipe"),
            paddingFn: (viewportSize) => {
              if (viewportSize.x < 600) {
                // Mobile: Smaller padding
                return { top: 10, bottom: 10, left: 10, right: 10 };
              }
              // Desktop: More padding
              return { top: 40, bottom: 40, left: 40, right: 40 };
            },
          });
          lightbox.init();
        }
      }
    });
  });

  const modal = document.getElementById("modal");
  const config = { childList: true, subtree: true };
  if (modal) observer.observe(modal, config);
</script>
